# Copy this file to `.env.local` and fill in real values.
# `.env.local` and all other `.env*` files are gitignored and must never be committed.
#
# Naming rules:
#   NEXT_PUBLIC_* - exposed to the browser bundle. Never put secrets here.
#   (no prefix)   - server-only, readable in Server Components, Route Handlers,
#                   Server Actions and other server-side code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use the anon key name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GitHub App credentials for read-only repository access. Keep these server-only.
# Register /api/github/oauth/callback as the user authorization callback URL and
# /api/github/install/callback as the setup URL in the GitHub App settings.
# Request only Contents, Issues, and Pull requests permissions (Read-only).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Base64-encoded 32-byte key used to encrypt GitHub user tokens at rest.
GITHUB_TOKEN_ENCRYPTION_KEY=
